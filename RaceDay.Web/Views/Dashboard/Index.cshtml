@using RaceDay.Web.Services
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var fullName = Context.Session.GetString(SessionKeys.FullName);
    var now = DateTime.Now;
}

<h1 class="rd-title">Organiser dashboard</h1>
<p class="rd-subtitle">Welcome back, @fullName. Here is how your events are doing.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card rd-card rd-stat">
            <div class="rd-stat-value">@Model.TotalEvents</div>
            <div class="rd-stat-label">Events created</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card rd-card rd-stat">
            <div class="rd-stat-value">@Model.Upcoming.Count</div>
            <div class="rd-stat-label">Upcoming events</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card rd-card rd-stat">
            <div class="rd-stat-value">@Model.TotalEnrolments</div>
            <div class="rd-stat-label">Total enrolments</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card rd-card rd-stat">
            <div class="rd-stat-value">@(Model.NextEvent != null ? Model.NextEvent.EventDate.ToString("d MMM") : "-")</div>
            <div class="rd-stat-label">@(Model.NextEvent != null ? "Next: " + Model.NextEvent.Name : "No upcoming events")</div>
        </div>
    </div>
</div>

@if (Model.TotalEvents == 0)
{
    <div class="card rd-card">
        <div class="card-body rd-empty">
            <p class="mb-3">You have not created any events yet.</p>
            <a asp-controller="ManageEvents" asp-action="Create" class="btn btn-primary">Create your first event</a>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h4 mb-0">Your events</h2>
        <a asp-controller="ManageEvents" asp-action="Create" class="btn btn-primary btn-sm">+ Create event</a>
    </div>

    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th class="text-center">Enrolments</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.Upcoming.Concat(Model.Past))
                {
                    var isUpcoming = ev.EventDate >= now;
                    <tr>
                        <td>
                            <div class="fw-semibold">@ev.Name</div>
                            <span class="rd-type rd-type-@ev.EventType.ToLower()">@ev.EventType</span>
                        </td>
                        <td>
                            @ev.EventDate.ToString("ddd, d MMM yyyy")<br />
                            <small class="text-muted">@ev.EventDate.ToString("HH:mm")</small>
                        </td>
                        <td>@ev.Location</td>
                        <td class="text-center fw-semibold">@ev.EnrolmentCount</td>
                        <td>
                            @if (isUpcoming)
                            {
                                <span class="badge text-bg-success">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Completed</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="ManageEvents" asp-action="Edit" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-secondary">Enrolments</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}