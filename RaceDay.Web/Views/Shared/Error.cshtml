@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="rd-empty">
    <h1 class="rd-title">Something went wrong</h1>
    <p>We could not complete that request. Please try again, or head back to the home page.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small mt-4">Reference: <code>@Model.RequestId</code></p>
    }
</div>