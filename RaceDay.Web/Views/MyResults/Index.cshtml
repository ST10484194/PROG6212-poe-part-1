@using RaceDay.Web.Services
@model MyResultsViewModel
@{
    ViewData["Title"] = "My results";
}

<h1 class="rd-title">My results</h1>
<p class="rd-subtitle">Your personal race history across every event you have finished.</p>

@if (!Model.Results.Any())
{
    <div class="card rd-card">
        <div class="card-body rd-empty">
            <p class="mb-3">No results yet. Your finish times appear here once an organiser has captured them.</p>
            <a asp-controller="MyEnrolments" asp-action="Index" class="btn btn-primary">View my enrolments</a>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card rd-card rd-stat">
                <div class="rd-stat-value">@Model.Races</div>
                <div class="rd-stat-label">Races finished</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card rd-card rd-stat">
                <div class="rd-stat-value">@(Model.BestPosition.HasValue ? RaceFormat.Ordinal(Model.BestPosition.Value) : "-")</div>
                <div class="rd-stat-label">Best finishing position</div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Results)
                {
                    <tr>
                        <td class="fw-semibold">@r.EventName</td>
                        <td>@r.EventDate.ToString("d MMM yyyy")</td>
                        <td>@r.CategoryName</td>
                        <td class="fw-semibold">@RaceFormat.Time(r.FinishTime)</td>
                        <td>@RaceFormat.Ordinal(r.FinishingPosition) out of @r.TotalFinishers @(r.TotalFinishers == 1 ? "finisher" : "finishers")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}