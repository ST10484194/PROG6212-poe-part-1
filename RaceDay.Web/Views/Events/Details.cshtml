@using RaceDay.Web.Services
@model EventDetailViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
    var bannerStyle = string.IsNullOrEmpty(ev.BannerImageUrl) ? null : $"background-image: url('{ev.BannerImageUrl}');";
    var categories = ev.Categories ?? new List<CategoryDto>();
}

<a asp-action="Index" class="text-decoration-none">&larr; Back to events</a>

<div class="row g-4 mt-1">
    <div class="col-lg-8">
        <div class="rd-banner-lg mb-4" style="@bannerStyle">
            <span class="rd-type rd-type-@ev.EventType.ToLower()">@ev.EventType</span>
        </div>

        <h1 class="rd-title">@ev.Name</h1>
        <p class="rd-subtitle">Organised by @ev.OrganiserName</p>

        <div class="card rd-card mb-4">
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-4">
                        <div class="rd-stat-value">@ev.EventDate.ToString("d MMM")</div>
                        <div class="rd-stat-label">@ev.EventDate.ToString("yyyy") at @ev.EventDate.ToString("HH:mm")</div>
                    </div>
                    <div class="col-4">
                        <div class="rd-stat-value">@ev.DistanceKm.ToString("0.##")</div>
                        <div class="rd-stat-label">Kilometres</div>
                    </div>
                    <div class="col-4">
                        <div class="rd-stat-value">@ev.EnrolmentCount</div>
                        <div class="rd-stat-label">Entered so far</div>
                    </div>
                </div>
                <hr />
                <p class="mb-0"><strong>Location:</strong> @ev.Location</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(ev.Description))
        {
            <h2 class="h4">About this event</h2>
            <p style="white-space: pre-line;">@ev.Description</p>
        }

        <h2 class="h4 mt-4">Available categories</h2>
        @if (!categories.Any())
        {
            <p class="text-muted">The organiser has not added any categories yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table rd-table align-middle">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Ages</th>
                            <th>Distance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in categories)
                        {
                            <tr>
                                <td class="fw-semibold">@c.CategoryName</td>
                                <td>@RaceFormat.AgeRange(c.MinAge, c.MaxAge)</td>
                                <td>@RaceFormat.Distance(c.DistanceKm)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card rd-card">
            <div class="card-body p-4">
                @if (Model.MyEnrolment != null)
                {
                    <h2 class="h4">You are entered</h2>
                    <p class="mb-2">Category: <strong>@Model.MyEnrolment.CategoryName</strong></p>
                    <p>Status: <span class="rd-status rd-status-@Model.MyEnrolment.EnrolmentStatus.ToLower()">@Model.MyEnrolment.EnrolmentStatus</span></p>
                    <a asp-controller="MyEnrolments" asp-action="Index" class="btn btn-outline-primary w-100">View my enrolments</a>
                }
                else if (Model.HasTakenPlace)
                {
                    <h2 class="h4">Event finished</h2>
                    <p class="mb-0">This event has already taken place, so entries are closed.</p>
                }
                else if (!categories.Any())
                {
                    <h2 class="h4">Entries not open yet</h2>
                    <p class="mb-0">The organiser has not added any categories yet, so you cannot enter at the moment.</p>
                }
                else
                {
                    <h2 class="h4">Enter this event</h2>
                    <p class="text-muted">Choose your category.</p>

                    <form asp-action="Enrol" asp-route-id="@ev.EventID" method="post">
                        @foreach (var c in categories)
                        {
                            <div class="border rounded p-2 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="categoryId" id="@("cat" + c.CategoryID)" value="@c.CategoryID" required />
                                    <label class="form-check-label w-100" for="@("cat" + c.CategoryID)">
                                        <span class="fw-semibold">@c.CategoryName</span><br />
                                        <small class="text-muted">Ages @RaceFormat.AgeRange(c.MinAge, c.MaxAge) &middot; @RaceFormat.Distance(c.DistanceKm)</small>
                                    </label>
                                </div>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary w-100 mt-2">Enter event</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>