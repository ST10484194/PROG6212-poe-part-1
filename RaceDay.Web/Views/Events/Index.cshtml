@model EventListViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<h1 class="rd-title">Upcoming events</h1>
<p class="rd-subtitle">Find your next run, walk or ride and enter in a few clicks.</p>

<form asp-action="Index" method="get" class="card rd-card mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label for="search" class="form-label mb-1">Search</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or location" />
            </div>
            <div class="col-md-3">
                <label for="eventType" class="form-label mb-1">Type</label>
                <select id="eventType" name="eventType" class="form-select">
                    <option value="" selected="@string.IsNullOrEmpty(Model.EventType)">All types</option>
                    <option value="Run" selected="@(Model.EventType == "Run")">Run</option>
                    <option value="Walk" selected="@(Model.EventType == "Walk")">Walk</option>
                    <option value="Cycle" selected="@(Model.EventType == "Cycle")">Cycle</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (Model.HasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="card rd-card">
        <div class="card-body rd-empty">
            @if (Model.HasFilters)
            {
                <p class="mb-3">No upcoming events match your search.</p>
                <a asp-action="Index" class="btn btn-primary">Show all events</a>
            }
            else
            {
                <p class="mb-0">There are no upcoming events right now. Please check back soon.</p>
            }
        </div>
    </div>
}
else
{
    <p class="text-muted">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events") found</p>

    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            var bannerStyle = string.IsNullOrEmpty(ev.BannerImageUrl) ? null : $"background-image: url('{ev.BannerImageUrl}');";

            <div class="col-md-6 col-lg-4">
                <div class="card rd-card rd-event-card">
                    <div class="rd-banner" style="@bannerStyle">
                        <span class="rd-type rd-type-@ev.EventType.ToLower()">@ev.EventType</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h3 class="h5">@ev.Name</h3>
                        <p class="mb-1"><strong>@ev.EventDate.ToString("ddd, d MMM yyyy")</strong> at @ev.EventDate.ToString("HH:mm")</p>
                        <p class="mb-1 text-muted">@ev.Location</p>
                        <p class="mb-3 text-muted">@ev.DistanceKm.ToString("0.##") km</p>
                        <a asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-primary mt-auto">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}