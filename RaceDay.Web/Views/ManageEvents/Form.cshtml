@model EventFormViewModel
@{
    var isEdit = Model.EventID.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="rd-title">@(isEdit ? "Edit event" : "Create event")</h1>
        <p class="rd-subtitle">@(isEdit ? "Update the details of your event." : "Enter the details of your new event.")</p>

        <div class="card rd-card">
            <div class="card-body p-4">
                <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.EventID" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="BannerImageUrl" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="EventDate"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>
                            <span asp-validation-for="EventType"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="DistanceKm" class="form-label"></label>
                            <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="DistanceKm"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BannerImage" class="form-label"></label>
                        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.BannerImageUrl" alt="Current banner" class="img-fluid rounded" style="max-height: 160px;" />
                            </div>
                        }
                        <input asp-for="BannerImage" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                        <div class="form-text">
                            JPG, PNG or WEBP, up to 5 MB.
                            @(isEdit ? "Choose a new image to replace the current banner." : "Optional.")
                        </div>
                        <span asp-validation-for="BannerImage"></span>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}